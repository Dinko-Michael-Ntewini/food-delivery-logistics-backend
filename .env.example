APP_NAME=Food Delivery & Logistics API
APP_ENV=development
DEBUG=false
# PostgreSQL example: postgresql+psycopg://USER:PASSWORD@localhost:5432/food_delivery
# SQLite is supported for local development and migration verification.
DATABASE_URL=sqlite:///./food_delivery.db
# Use a long, randomly generated value outside local development.
SECRET_KEY=replace-with-a-long-random-secret-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
# Admin bootstrap reads these from the shell environment; never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Platform Administrator
